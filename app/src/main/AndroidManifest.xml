<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    
    <!-- Hardware features (optional) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SAFE_KIDS">
        
        <!-- Authentication Activity -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS">
        </activity>

        <!-- Toggleable Launcher Icon -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Parent Dashboard Activity -->
        <activity
            android:name=".ui.parent.ParentDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Downtime Management Activity -->
        <activity
            android:name=".ui.parent.DowntimeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- App Management Activity -->
        <activity
            android:name=".ui.parent.AppManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- App Blocker Picker Activity -->
        <activity
            android:name=".ui.parent.AppBlockerPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Add App Limit Activity -->
        <activity
            android:name=".ui.parent.AddAppLimitActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Notification Monitoring Activity -->
        <activity
            android:name=".ui.parent.NotificationMonitoringActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Social Content Detection Activity -->
        <activity
            android:name=".ui.parent.SocialContentDetectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Inappropriate Image Detection Activity -->
        <activity
            android:name=".ui.parent.InappropriateImageDetectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Calls & SMS Monitoring Activity -->
        <activity
            android:name=".ui.parent.CallsSmsMonitoringActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Keyword Management Activity -->
        <activity
            android:name=".ui.parent.KeywordManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Required Permissions Activity -->
        <activity
            android:name=".ui.parent.RequiredPermissionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- SOS Settings Activity -->
        <activity
            android:name=".ui.parent.SosSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Browsing History Activity -->
        <activity
            android:name=".ui.parent.BrowsingHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Add Downtime Activity -->
        <activity
            android:name=".ui.parent.AddDowntimeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Child Setup Activity (placeholder) -->
        <activity
            android:name=".ui.parent.ChildSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        
        <activity
            android:name=".ui.parent.PlanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
        
        <activity
            android:name=".ui.parent.TodaysEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
        
        <activity
            android:name=".ui.admin.AdminCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <activity
            android:name=".ui.parent.ParentAdminCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
            
        <activity
            android:name=".ui.child.ParentalSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS" />
            
        <activity
            android:name=".ui.chat.FamilyChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Chat Activity -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <activity
            android:name=".ui.parent.ManageCoParentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
            
        <activity
            android:name=".ui.parent.ChildDevicesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <activity
            android:name=".ui.parent.ZoneManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
        
        <!-- Screen Time Activities -->
        <activity
            android:name=".ui.child.TotalLockoutActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SAFE_KIDS" />
            
        <activity
            android:name=".ui.parent.GlobalScreenTimeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />
            
        <!-- Child Mode Activity -->
        <activity
            android:name=".ui.child.ChildModeActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />
        

        
        <!-- App Blocked Activity -->
        <activity
            android:name=".services.AppBlockedActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS"
            android:launchMode="singleTop" />

        <!-- Study Mode Block Activity -->
        <activity
            android:name=".services.StudyModeBlockActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS"
            android:launchMode="singleTop" />

        <!-- Admin Dashboard Activity -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SAFE_KIDS" />

        <!-- Uninstall Protection Activity -->
        <activity
            android:name=".services.UninstallProtectionActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />
        
        <!-- Settings Activity -->
        <activity
            android:name=".ui.self.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SAFE_KIDS" />

        
        <!-- Device Admin Receiver -->
        <receiver
            android:name=".services.DeviceAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        
        <!-- Foreground Protection Service -->
        <service
            android:name=".services.ForegroundProtectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location"
            android:description="@string/location_service_description" />
        
        <!-- Accessibility Service -->
        <service
            android:name=".services.SafeKidsAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        
        <!-- Firebase Messaging Service -->
        <service
            android:name=".services.firebase.SafeKidsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Child Notification Listener (forwards child notifications to parent) -->
        <service
            android:name=".services.ChildNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        
        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <service 
            android:name=".services.SOSListenerService"
            android:foregroundServiceType="specialUse"
            android:description="@string/sos_service_description"
            android:enabled="true"
            android:exported="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="Emergency monitoring for child safety and SOS alerts" />
        </service>

        <activity
            android:name=".ui.parent.ReportsActivity"
            android:theme="@style/Theme.SAFE_KIDS"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.parent.ChildLocationMapActivity"
            android:theme="@style/Theme.SAFE_KIDS"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ui.parent.EmergencyAlertActivity"

            android:theme="@style/Theme.SAFE_KIDS"
            android:showOnLockScreen="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Boot Receiver -->
        <receiver
            android:name=".services.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Secret Code Receiver (*#*#7233#*#*) -->
        <receiver
            android:name=".services.SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7233" />
            </intent-filter>
        </receiver>
        
    <activity
    android:name=".ui.parent.SleepModeActivity"
    android:exported="false"
    android:windowSoftInputMode="adjustResize"
    android:theme="@style/Theme.SAFE_KIDS" />
<activity
    android:name=".ui.parent.StudyModeActivity"
    android:exported="false"
    android:windowSoftInputMode="adjustResize"
    android:theme="@style/Theme.SAFE_KIDS" />
<activity
    android:name=".ui.parent.AddChildPairingActivity"
    android:exported="false"
    android:windowSoftInputMode="adjustResize"
    android:theme="@style/Theme.SAFE_KIDS" />
</application>

</manifest>